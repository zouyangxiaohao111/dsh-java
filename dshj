#!/usr/bin/env bash
# dshj — dsh-java 命令行入口(M6-4)。优先用 installDist(免 gradle,秒起);
# dist 未构建时回退 Gradle run。
#
# 用法(与 dsh 启动器同形):
#   ./dshj [--profile <name>] boot [appArgs...]
#   ./dshj web|headless|cli [boot] [appArgs...]
#   ./dshj plugin --profile <name> add <spec>
#   ./dshj --help
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DIST="$DIR/dsh-host/build/install/dsh-host/bin/dsh-host"
if [ -x "$DIST" ]; then
  # M9-2:installDist 直接运行(Java -cp,无 gradle 启动);以仓库根为 cwd(profiles/ 与 vendor/dsh 相对它)。
  cd "$DIR"
  exec "$DIST" "$@"
fi

# 回退:Gradle run。参数做 shell-safe 引号包裹(Gradle 按引号感知拆分)。
ARGS=""
for a in "$@"; do
  qa=$(printf '%s' "$a" | sed 's/\\/\\\\/g; s/"/\\"/g')
  ARGS="${ARGS} \"${qa}\""
done
if [ -n "$ARGS" ]; then
  ARGS="${ARGS# }"
fi

exec "$DIR/gradlew" -p "$DIR" -q :dsh-host:run --args="$ARGS"
